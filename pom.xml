<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.advantest.markdown</groupId>
	<artifactId>markdown-ls</artifactId>
	<version>1.0.0-SNAPSHOT</version>

	<name>Markdown language server</name>
	<description>Offers the Markdown language service to editors through the Language Server Protocol</description>

	<organization>
		<name>Advantest Europe</name>
		<url>https://www.advantest.com/</url>
	</organization>

	<licenses>
		<license>
			<name>BSD-3-Clause</name>
			<url>https://opensource.org/licenses/BSD-3-Clause</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<properties>
		<markdown-service-version>1.0.0-SNAPSHOT</markdown-service-version>
		<markdown-core-version>2.0.0-SNAPSHOT</markdown-core-version>
		<flexmark-extensions-version>2.0.0-SNAPSHOT</flexmark-extensions-version>
		<flexmark-version>0.66.0-SNAPSHOT</flexmark-version>
		<lsp4j-version>1.0.0</lsp4j-version>
		<gson-version>2.15.0</gson-version>
		<error-prone-annotations-version>2.50.0</error-prone-annotations-version>
		<java-version>21</java-version>
		<junit-version>5.9.2</junit-version>
		<slf4j-version>2.0.18</slf4j-version>
		<jacoco-version>0.8.15</jacoco-version>
		<!-- The release of the SPDX licence list whose texts the distribution ships. -->
		<spdx-license-list-version>v3.29.0</spdx-license-list-version>
		<!-- The groups of the components PlantUML's JAR holds in compiled form. Maven resolves them
		     as dependencies of PlantUML, which lists them under the licences they name, but lib/ and
		     the class path leave them out, so that their classes are not there twice. -->
		<plantuml-bundled-group-ids>org.scilab.forge,org.eclipse.elk,org.eclipse.emf,com.google.guava,com.google.errorprone,com.google.j2objc,org.jspecify</plantuml-bundled-group-ids>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.source>${java-version}</maven.compiler.source>
		<maven.compiler.target>${java-version}</maven.compiler.target>
		<java.version>${java-version}</java.version>
	</properties>

	<repositories>
		<repository>
			<id>github-packages-flexmark</id>
			<url>https://maven.pkg.github.com/advantest/flexmark-java</url>
		</repository>
		<repository>
			<id>github-packages-flexmark-extensions</id>
			<url>https://maven.pkg.github.com/advantest/flexmark-extensions</url>
		</repository>
		<repository>
			<id>github-packages-markdown-core</id>
			<url>https://maven.pkg.github.com/advantest/markdown-core</url>
		</repository>
		<repository>
			<id>github-packages-markdown-service</id>
			<url>https://maven.pkg.github.com/advantest/markdown-service</url>
		</repository>
	</repositories>

	<dependencyManagement>
		<dependencies>
			<!-- LSP4J accepts any Gson from a range of versions, which would let the version used
			     change from one build to the next. This one is fixed instead. -->
			<dependency>
				<groupId>com.google.code.gson</groupId>
				<artifactId>gson</artifactId>
				<version>${gson-version}</version>
			</dependency>
			<!-- Gson and Guava, which the Markdown service brings along, ask for different versions of
			     these annotations. They are read by the compiler only, so the newer one serves both. -->
			<dependency>
				<groupId>com.google.errorprone</groupId>
				<artifactId>error_prone_annotations</artifactId>
				<version>${error-prone-annotations-version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>

		<dependency>
			<groupId>com.advantest.markdown</groupId>
			<artifactId>markdown-service</artifactId>
			<version>${markdown-service-version}</version>
		</dependency>

		<dependency>
			<groupId>com.advantest.markdown</groupId>
			<artifactId>markdown-core</artifactId>
			<version>${markdown-core-version}</version>
		</dependency>

		<dependency>
			<groupId>com.advantest.flexmark</groupId>
			<artifactId>flexmark-extensions-info</artifactId>
			<version>${flexmark-extensions-version}</version>
		</dependency>

		<dependency>
			<groupId>com.vladsch.flexmark</groupId>
			<artifactId>flexmark</artifactId>
			<version>${flexmark-version}</version>
		</dependency>

		<dependency>
			<groupId>org.eclipse.lsp4j</groupId>
			<artifactId>org.eclipse.lsp4j</artifactId>
			<version>${lsp4j-version}</version>
		</dependency>

		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j-version}</version>
		</dependency>

		<!-- The libraries write to the logging API, and the server, being the program, decides where
		     the lines go: to the logging of the JDK, which LSP4J writes to as well and which writes
		     to standard error. Standard output belongs to the protocol. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-jdk14</artifactId>
			<version>${slf4j-version}</version>
		</dependency>

		<!-- test dependencies -->

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>${junit-version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-params</artifactId>
			<version>${junit-version}</version>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>

		<!-- The version of the server goes into a resource named after its coordinates, so that it
		     cannot be mistaken for the resource of another library on the same class path.
		     Filtering writes it into the class folder as well, so the IDEs see it, too. -->
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<directory>src/version</directory>
				<filtering>true</filtering>
				<targetPath>META-INF/${project.groupId}/${project.artifactId}</targetPath>
			</resource>
		</resources>

		<plugins>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<id>enforce-versions</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>[3.9.0,4)</version>
								</requireMavenVersion>
								<requireJavaVersion>
									<version>21</version>
								</requireJavaVersion>
								<dependencyConvergence/>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<configuration>
					<propertiesEncoding>UTF-8</propertiesEncoding>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<release>21</release>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.1.2</version>
				<configuration>
					<systemPropertyVariables>
						<markdown-ls.version>${project.version}</markdown-ls.version>
						<markdown-service.version>${markdown-service-version}</markdown-service.version>
						<markdown-core.version>${markdown-core-version}</markdown-core.version>
						<flexmark-extensions.version>${flexmark-extensions-version}</flexmark-extensions.version>
						<flexmark.version>${flexmark-version}</flexmark.version>
					</systemPropertyVariables>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.junit.jupiter</groupId>
						<artifactId>junit-jupiter-engine</artifactId>
						<version>${junit-version}</version>
					</dependency>
				</dependencies>
			</plugin>

			<!-- Runs the tests that start the server as a process of its own, named *IT. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.1.2</version>
				<configuration>
					<systemPropertyVariables>
						<markdown-ls.server-jvm-option>${serverJacocoAgent}</markdown-ls.server-jvm-option>
						<markdown-ls.version>${project.version}</markdown-ls.version>
						<markdown-ls.build-directory>${project.build.directory}</markdown-ls.build-directory>
						<markdown-ls.local-repository>${settings.localRepository}</markdown-ls.local-repository>
					</systemPropertyVariables>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.junit.jupiter</groupId>
						<artifactId>junit-jupiter-engine</artifactId>
						<version>${junit-version}</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Measures how much of the code the tests reach, without judging the result. The server
			     processes that the *IT tests start get the agent through the property serverJacocoAgent,
			     and the report at verify covers the unit tests and the process tests together. It is
			     written to target/site/jacoco/index.html. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco-version}</version>
				<executions>
					<execution>
						<id>prepare-coverage-measurement</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>prepare-process-coverage-measurement</id>
						<goals>
							<goal>prepare-agent-integration</goal>
						</goals>
						<configuration>
							<propertyName>serverJacocoAgent</propertyName>
						</configuration>
					</execution>
					<execution>
						<id>merge-coverage</id>
						<phase>post-integration-test</phase>
						<goals>
							<goal>merge</goal>
						</goals>
						<configuration>
							<fileSets>
								<fileSet>
									<directory>${project.build.directory}</directory>
									<includes>
										<include>jacoco.exec</include>
										<include>jacoco-it.exec</include>
									</includes>
								</fileSet>
							</fileSets>
							<destFile>${project.build.directory}/jacoco-merged.exec</destFile>
						</configuration>
					</execution>
					<execution>
						<id>report-coverage</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
						<configuration>
							<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- A thin jar, whose manifest names the main class and the dependencies in lib/, so that
			     "java -jar markdown-ls.jar" works in the distribution as well as the start scripts. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.1</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>com.advantest.markdown.ls.MarkdownLanguageServer</mainClass>
							<!-- Implementation-Version names the version the server answers on initialize. -->
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
						<manifestEntries>
							<Class-Path>${markdown-ls.manifest-class-path}</Class-Path>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>

			<!-- The distribution names the third-party components it ships in lib/ and their licences.
			     THIRD-PARTY.txt lists the components by licence, licenses/ holds the text of each licence,
			     taken from the SPDX licence list rather than from the web pages the components name, and
			     notices/ holds the licence and notice files each component's JAR carries, which name its
			     copyright holders, together with those of src/license/notices for the components whose
			     JARs carry none. The build fails where a component names no licence or a licence text
			     cannot be downloaded. The URLs naming the GPL leave open whether a later version may be
			     chosen; the components shipped today allow it. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>license-maven-plugin</artifactId>
				<version>2.9.0</version>
				<configuration>
					<includedScopes>compile,runtime</includedScopes>
				</configuration>
				<executions>
					<execution>
						<id>list-third-party-components</id>
						<goals>
							<goal>add-third-party</goal>
						</goals>
						<configuration>
							<fileTemplate>${project.basedir}/src/license/third-party.ftl</fileTemplate>
							<!-- Ships with the distribution, not inside markdown-ls.jar. -->
							<addOutputDirectoryAsResourceDir>false</addOutputDirectoryAsResourceDir>
							<failOnMissing>true</failOnMissing>
							<licenseMerges>
								<licenseMerge>Apache-2.0|Apache 2.0|Apache License, Version 2.0|The Apache Software License, Version 2.0|The Apache License, Version 2.0</licenseMerge>
								<licenseMerge>BSD-2-Clause|BSD 2-Clause License</licenseMerge>
								<licenseMerge>EPL-1.0|The Eclipse Public License Version 1.0|EPL License</licenseMerge>
								<licenseMerge>EPL-2.0|Eclipse Public License, Version 2.0</licenseMerge>
								<licenseMerge>GPL-2.0-or-later WITH Classpath-exception-2.0|GPLv2 with Classpath Exception</licenseMerge>
								<licenseMerge>MIT|MIT License|The MIT License</licenseMerge>
							</licenseMerges>
						</configuration>
					</execution>
					<execution>
						<id>download-third-party-licences</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>download-licenses</goal>
						</goals>
						<configuration>
							<licensesOutputDirectory>${project.build.directory}/third-party/licenses</licensesOutputDirectory>
							<licensesOutputFile>${project.build.directory}/third-party/licenses.xml</licensesOutputFile>
							<cleanLicensesOutputDirectory>true</cleanLicensesOutputDirectory>
							<errorRemedy>failFast</errorRemedy>
							<licenseUrlReplacements>
							<licenseUrlReplacement>
								<regexp>(?i)https?://(www\.)?apache\.org/licenses/LICENSE-2\.0(\.txt|\.html)?</regexp>
								<replacement>https://raw.githubusercontent.com/spdx/license-list-data/${spdx-license-list-version}/text/Apache-2.0.txt</replacement>
							</licenseUrlReplacement>
							<licenseUrlReplacement>
								<regexp>(?i)https?://(www\.)?opensource\.org/licenses?/BSD-2-Clause</regexp>
								<replacement>https://raw.githubusercontent.com/spdx/license-list-data/${spdx-license-list-version}/text/BSD-2-Clause.txt</replacement>
							</licenseUrlReplacement>
							<licenseUrlReplacement>
								<regexp>(?i)https?://(www\.)?opensource\.org/licenses?/BSD-3-Clause</regexp>
								<replacement>https://raw.githubusercontent.com/spdx/license-list-data/${spdx-license-list-version}/text/BSD-3-Clause.txt</replacement>
							</licenseUrlReplacement>
							<licenseUrlReplacement>
								<regexp>(?i)https?://(www\.)?opensource\.org/licenses?/mit(-license\.php)?</regexp>
								<replacement>https://raw.githubusercontent.com/spdx/license-list-data/${spdx-license-list-version}/text/MIT.txt</replacement>
							</licenseUrlReplacement>
							<licenseUrlReplacement>
								<regexp>(?i)https?://(www\.)?eclipse\.org/legal/epl-v10\.html</regexp>
								<replacement>https://raw.githubusercontent.com/spdx/license-list-data/${spdx-license-list-version}/text/EPL-1.0.txt</replacement>
							</licenseUrlReplacement>
							<licenseUrlReplacement>
								<regexp>(?i)https?://(www\.)?eclipse\.org/legal/epl-2\.0/?</regexp>
								<replacement>https://raw.githubusercontent.com/spdx/license-list-data/${spdx-license-list-version}/text/EPL-2.0.txt</replacement>
							</licenseUrlReplacement>
							<licenseUrlReplacement>
								<regexp>(?i)https?://(www\.)?gnu\.org/licenses/old-licenses/gpl-2\.0\.txt</regexp>
								<replacement>https://raw.githubusercontent.com/spdx/license-list-data/${spdx-license-list-version}/text/GPL-2.0-or-later.txt</replacement>
							</licenseUrlReplacement>
							<licenseUrlReplacement>
								<regexp>(?i)https?://(www\.)?opensource\.org/licenses?/epl-1-0/?</regexp>
								<replacement>https://raw.githubusercontent.com/spdx/license-list-data/${spdx-license-list-version}/text/EPL-1.0.txt</replacement>
							</licenseUrlReplacement>
							</licenseUrlReplacements>
							<licenseUrlFileNames>
							<Apache-2.0.txt>.*/text/Apache-2\.0\.txt</Apache-2.0.txt>
							<BSD-2-Clause.txt>.*/text/BSD-2-Clause\.txt</BSD-2-Clause.txt>
							<BSD-3-Clause.txt>.*/text/BSD-3-Clause\.txt</BSD-3-Clause.txt>
							<MIT.txt>.*/text/MIT\.txt</MIT.txt>
							<EPL-1.0.txt>.*/text/EPL-1\.0\.txt</EPL-1.0.txt>
							<EPL-2.0.txt>.*/text/EPL-2\.0\.txt</EPL-2.0.txt>
							<GPL-2.0-or-later.txt>.*/text/GPL-2\.0-or-later\.txt</GPL-2.0-or-later.txt>
							</licenseUrlFileNames>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.11.0</version>
				<executions>
					<!-- The JARs the distribution ships in lib/. -->
					<execution>
						<id>collect-libraries</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<excludeGroupIds>${plantuml-bundled-group-ids}</excludeGroupIds>
							<outputDirectory>${project.build.directory}/lib</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<id>collect-third-party-notices</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>unpack-dependencies</goal>
						</goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<includes>META-INF/LICENSE*,META-INF/NOTICE*,META-INF/COPYING*,about.html,org/scilab/forge/jlatexmath/fonts/licences/*</includes>
							<useSubDirectoryPerArtifact>true</useSubDirectoryPerArtifact>
							<outputDirectory>${project.build.directory}/third-party/notices</outputDirectory>
						</configuration>
					</execution>
					<!-- The GPL obliges whoever distributes a component in binary form to offer its
					     source from the same place, so the distribution ships the source JARs of the
					     components under the GPL: jlatexmath and its two fonts. -->
					<execution>
						<id>collect-gpl-sources</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<includeGroupIds>org.scilab.forge</includeGroupIds>
							<classifier>sources</classifier>
							<failOnMissingClassifierArtifact>true</failOnMissingClassifierArtifact>
							<outputDirectory>${project.build.directory}/third-party/sources</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- A CycloneDX software bill of materials of the server and the components it ships,
			     target/bom.json, which the distribution carries. The plugin needs the network and skips
			     an offline build, which therefore fails when packaging. -->
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
				<version>2.9.3</version>
				<executions>
					<execution>
						<id>software-bill-of-materials</id>
						<phase>package</phase>
						<goals>
							<goal>makeBom</goal>
						</goals>
						<configuration>
							<projectType>application</projectType>
							<outputFormat>json</outputFormat>
							<outputName>bom</outputName>
							<includeCompileScope>true</includeCompileScope>
							<includeRuntimeScope>true</includeRuntimeScope>
							<includeProvidedScope>false</includeProvidedScope>
							<includeSystemScope>false</includeSystemScope>
							<includeTestScope>false</includeTestScope>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- The SBOM takes the licences from the POMs of the components, two of which name them
			     imprecisely: PlantUML names the EPL without its version, which its source states as 1.0,
			     and jlatexmath names the GPL 2 only with the Classpath exception, while its source allows
			     any later version. Both are corrected to the SPDX expressions THIRD-PARTY.txt names, and
			     the build fails where one of the imprecise licences remains or where the SBOM names
			     PlantUML's edition under the GPL. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<!-- The Class-Path of the jar's manifest, naming the JARs collected for lib/. The
					     maven-dependency-plugin cannot write it, since Maven trims the space separating
					     the names. -->
					<execution>
						<id>class-path-for-manifest</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<exportAntProperties>true</exportAntProperties>
							<target>
								<pathconvert property="markdown-ls.manifest-class-path" pathsep=" ">
									<sort>
										<fileset dir="${project.build.directory}/lib" includes="*.jar"/>
									</sort>
									<chainedmapper>
										<flattenmapper/>
										<globmapper from="*" to="lib/*"/>
									</chainedmapper>
								</pathconvert>
							</target>
						</configuration>
					</execution>
					<execution>
						<id>correct-sbom-licences</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<property name="bom" location="${project.build.directory}/bom.json"/>
								<fail message="bom.json is missing. The CycloneDX plugin needs the network and skips an offline build.">
									<condition>
										<not>
											<available file="${bom}"/>
										</not>
									</condition>
								</fail>
								<replaceregexp file="${bom}" flags="g" encoding="UTF-8"
										match="&quot;name&quot; : &quot;EPL License&quot;"
										replace="&quot;id&quot; : &quot;EPL-1.0&quot;"/>
								<replaceregexp file="${bom}" flags="gs" encoding="UTF-8"
										match="\{\s*&quot;license&quot; : \{\s*&quot;id&quot; : &quot;GPL-2\.0-with-classpath-exception&quot;\s*\}\s*\}"
										replace="{ &quot;expression&quot; : &quot;GPL-2.0-or-later WITH Classpath-exception-2.0&quot; }"/>
								<fail message="bom.json still names a licence imprecisely.">
									<condition>
										<or>
											<resourcecontains resource="${bom}" substring="EPL License"/>
											<resourcecontains resource="${bom}" substring="GPL-2.0-with-classpath-exception"/>
										</or>
									</condition>
								</fail>
								<fail message="bom.json names PlantUML's edition under the GPL.">
									<condition>
										<resourcecontains resource="${bom}" substring="pkg:maven/net.sourceforge.plantuml/plantuml@"/>
									</condition>
								</fail>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- The distribution: target/markdown-ls-<version>-distribution.zip and .tar.gz. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.7.1</version>
				<executions>
					<execution>
						<id>distribution</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<descriptors>
								<descriptor>src/assembly/distribution.xml</descriptor>
							</descriptors>
							<!-- The paths of some notices exceed the 100 characters of a plain tar entry. -->
							<tarLongFileMode>posix</tarLongFileMode>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Every Java file carries the header of src/license/header.txt. The build fails where
			     a header is missing or differs from it in anything but its year or year range,
			     which is left to the authors and reviewers. "mvn spotless:apply" adds a missing
			     header with the current year, to be reviewed before committing. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<encoding>UTF-8</encoding>
					<lineEndings>PRESERVE</lineEndings>
					<java>
						<includes>
							<include>src/*/java/**/*.java</include>
						</includes>
						<licenseHeader>
							<file>${project.basedir}/src/license/header.txt</file>
						</licenseHeader>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>check-license-headers</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

</project>
