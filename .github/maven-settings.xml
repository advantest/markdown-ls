<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven settings for the CI: the token of the workflow run reads the libraries markdown-ls depends on
     from GitHub Packages and deploys markdown-ls there. The jobs pass GITHUB_TOKEN as an environment variable. -->
<settings>
	<servers>
		<server>
			<id>github-packages-flexmark</id>
			<username>${env.GITHUB_ACTOR}</username>
			<password>${env.GITHUB_TOKEN}</password>
		</server>
		<server>
			<id>github-packages-flexmark-extensions</id>
			<username>${env.GITHUB_ACTOR}</username>
			<password>${env.GITHUB_TOKEN}</password>
		</server>
		<server>
			<id>github-packages-markdown-core</id>
			<username>${env.GITHUB_ACTOR}</username>
			<password>${env.GITHUB_TOKEN}</password>
		</server>
		<server>
			<id>github-packages-markdown-service</id>
			<username>${env.GITHUB_ACTOR}</username>
			<password>${env.GITHUB_TOKEN}</password>
		</server>
		<server>
			<id>github</id>
			<username>${env.GITHUB_ACTOR}</username>
			<password>${env.GITHUB_TOKEN}</password>
		</server>
	</servers>
</settings>
